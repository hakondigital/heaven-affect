# ── Shopify ──────────────────────────────────────────────────────────
# Optional until the headless store goes live. Without these the site still
# builds from the public catalogue and checks out through a Shopify cart
# permalink. With them, the bag creates a real Shopify cart (live inventory,
# discount codes, the works). Both values are public by design.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=theheaveneffect.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# The catalogue sync (npm run catalogue, also runs before every build) uses the
# same token if present — needed once the old Shopify theme is password-protected.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# ── Contact form (Resend) ─────────────────────────────────────────────
# Without a key the form falls back to a pre-filled email, so nothing is lost.
# In production these are Secrets on the Cloudflare worker, never in the repo.
RESEND_API_KEY=
CONTACT_TO=info@theheaveneffect.com.au
CONTACT_FROM=The Heaven Effect <noreply@theheaveneffect.com.au>
